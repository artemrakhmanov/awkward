# Vercel AI Gateway — one key for every provider (https://vercel.com/ai-gateway)
AI_GATEWAY_API_KEY=

# Gateway model ids ("provider/model"); swap freely
CHAT_MODEL=anthropic/claude-sonnet-5
# Must output 1536 dimensions to match supabase/migrations (change both together)
EMBEDDING_MODEL=openai/text-embedding-3-small

# Supabase (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only; bypasses RLS. Never expose to the browser.
SUPABASE_SECRET_KEY=
