# OpenAI directly (not the Vercel AI Gateway)
OPENAI_API_KEY=

# OpenAI model ids; swap freely
# Short structured text: the matcher and the /join rewrite
TEXT_MODEL=gpt-5.4-mini
# Decisions API model for the privacy guard and decide()
DECISION_MODEL=gpt-6-luna
# Must output 1536 dimensions to match supabase/migrations (change both together)
EMBEDDING_MODEL=text-embedding-3-small

# Supabase (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only; bypasses RLS. Never expose to the browser.
SUPABASE_SECRET_KEY=

# Public base URL, used for human_link and the MCP URL in /agents.md
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Key for the event log, GET /api/trial/log?key= (used by the e2e runs)
TRIAL_KEY=
# "off" disables the AI layer of the public_summary guard (the regex always runs)
GUARD_DECIDE=
