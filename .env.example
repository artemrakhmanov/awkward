# Vercel AI Gateway — one key for every provider (https://vercel.com/ai-gateway)
AI_GATEWAY_API_KEY=

# Gateway model ids ("provider/model"); swap freely
CHAT_MODEL=anthropic/claude-sonnet-5
# Must output 1536 dimensions to match supabase/migrations (change both together)
EMBEDDING_MODEL=openai/text-embedding-3-small

# Supabase (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only; bypasses RLS. Never expose to the browser.
SUPABASE_SECRET_KEY=

# Public base URL, used for human_link and the MCP URL in /agents.md
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Trial (specs/trial.md): key for GET /api/trial/log?key=
TRIAL_KEY=
# "on" enables the LLM layer of the public_summary guard (decide()). Off during the trial.
GUARD_DECIDE=
